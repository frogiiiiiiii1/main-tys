-- ==================== ESP ====================
local oreAdornments = {}
local espSettings = { Enabled = false, Tracers = false, MaxDistance = 1000 }

local ORE_NAMES = {
    "CubicBlockMetal",
    "CrystallineMetalOre",
    "OreMesh",
    "GemBlockMesh",
    "ShaleMetalBlock",
}

local oreStates = {}
for _, name in ipairs(ORE_NAMES) do
    oreStates[name] = true
end

local function isValuableOre(part)
    return oreStates[part.Name] == true
end

local function removeOreESP(part)
    local d = oreAdornments[part]
    if not d then return end
    if d.highlight then d.highlight:Destroy() end
    if d.attachment then d.attachment:Destroy() end
    if d.beam then d.beam:Destroy() end
    if d.connections then
        for _, c in ipairs(d.connections) do c:Disconnect() end
    end
    oreAdornments[part] = nil
end

local function addOreESP(part)
    if not part:IsA("BasePart") or oreAdornments[part] or not isValuableOre(part) then return end

    local highlight = Instance.new("Highlight")
    highlight.Adornee = part
    highlight.FillColor = part.Color
    highlight.OutlineColor = part.Color
    highlight.FillTransparency = 0.6
    highlight.OutlineTransparency = 0.3
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = espSettings.Enabled
    highlight.Parent = part

    local att = Instance.new("Attachment", part)

    local conns = {}
    table.insert(conns, part.Destroying:Connect(function() removeOreESP(part) end))
    table.insert(conns, part.AncestryChanged:Connect(function(_, p)
        if not p or not part:IsDescendantOf(workspace) then removeOreESP(part) end
    end))
    table.insert(conns, part:GetPropertyChangedSignal("Transparency"):Connect(function()
        if part.Transparency >= 1 then removeOreESP(part) end
    end))

    oreAdornments[part] = {
        highlight = highlight,
        attachment = att,
        beam = nil,
        connections = conns
    }
end

-- Цикл обновления ESP
task.spawn(function()
    while task.wait(0.3) do
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")

        if espSettings.Enabled and hrp then
            local placed = workspace:FindFirstChild("PlacedOre")
            if placed then
                for _, part in ipairs(placed:GetDescendants()) do
                    if part:IsA("BasePart") and not oreAdornments[part] and part.Transparency < 1 then
                        addOreESP(part)
                    end
                end
            end

            for part, data in pairs(oreAdornments) do
                if part and part.Parent and part:IsDescendantOf(workspace) and part.Transparency < 1 then
                    if not isValuableOre(part) then
                        removeOreESP(part)
                        continue
                    end

                    local dist = (hrp.Position - part.Position).Magnitude
                    local inRange = dist <= espSettings.MaxDistance

                    data.highlight.Enabled = inRange

                    if espSettings.Tracers and inRange then
                        if not data.beam then
                            local myAtt = hrp:FindFirstChild("RootAttachment") or hrp:FindFirstChildWhichIsA("Attachment")
                            if myAtt then
                                local beam = Instance.new("Beam")
                                beam.Attachment0 = myAtt
                                beam.Attachment1 = data.attachment
                                beam.Color = ColorSequence.new(part.Color)
                                beam.Width0 = 0.04
                                beam.Width1 = 0.04
                                beam.FaceCamera = true
                                beam.Parent = hrp
                                data.beam = beam
                            end
                        end
                    else
                        if data.beam then data.beam:Destroy(); data.beam = nil end
                    end
                else
                    removeOreESP(part)
                end
            end
        else
            for part, _ in pairs(oreAdornments) do
                removeOreESP(part)
            end
        end
    end
end)

