-- Single InputChanged handles window drag and all sliders
UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        -- Window drag
        if dragging then
            local delta = input.Position - dragStart
            mainFrame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end

        -- Speed slider
        if speedSliderDragging then
            local barSizeX = speedSliderBg.AbsoluteSize.X
            if barSizeX > 0 then
                local fraction = math.clamp((input.Position.X - speedSliderBg.AbsolutePosition.X) / barSizeX, 0, 1)
                speedValue = math.floor(16 + (200 - 16) * fraction + 0.5)
                updateSpeedSliderDisplay()
                if speedHackEnabled then applySpeed() end
            end
        end

        -- Fly slider
        if flySliderDragging then
            local barSizeX = flySliderBg.AbsoluteSize.X
            if barSizeX > 0 then
                local fraction = math.clamp((input.Position.X - flySliderBg.AbsolutePosition.X) / barSizeX, 0, 1)
                flySpeed = math.floor(20 + (200 - 20) * fraction + 0.5)
                updateFlySliderDisplay()
            end
        end

        -- ESP Distance slider
        if distSliderDragging then
            local barSizeX = distSliderBg.AbsoluteSize.X
            if barSizeX > 0 then
                local fraction = math.clamp((input.Position.X - distSliderBg.AbsolutePosition.X) / barSizeX, 0, 1)
                local val = math.floor(50 + (5000 - 50) * fraction + 0.5)
                updateDistSlider(val)
            end
        end
    end
end)

-- Right Shift toggle (keep separate, no conflict)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        mainFrame.Visible = not mainFrame.Visible
    end
end)
