    CurrentTheme = t

    mainFrame.BackgroundColor3 = t.Bg
    tabContainer.BackgroundColor3 = t.Sidebar
    titleBar.BackgroundColor3 = t.Element

    for _, element in ipairs(UI_Elements) do
        if element and element.Parent then
            if element:IsA("Frame") or element:IsA("TextButton") then
                element.BackgroundColor3 = t.Element
            end
        end
    end
    for _, stroke in ipairs(UI_Strokes) do
        if stroke and stroke.Parent then stroke.Color = t.Border end
    end
    for _, textElement in ipairs(UI_Texts) do
        if textElement and textElement.Parent then
            if textElement:IsA("TextLabel") or textElement:IsA("TextButton") then
                textElement.TextColor3 = t.Text
            end
        end
    end
    for _, btn in ipairs(UI_AccentButtons) do
        if btn and btn.Parent and btn:GetAttribute("Active") then
            btn.BackgroundColor3 = t.Accent
            btn.TextColor3 = t.Text
        end
    end
end

