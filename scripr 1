local function teleportToSaved(pos, btn)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        btn.Text = "No Character!"; wait(1); btn.Text = "Teleport to Saved "..(btn==choice1 and "1" or "2"); return
    end
    if not pos then
        btn.Text = "Position not saved!"; wait(1); btn.Text = "Teleport to Saved "..(btn==choice1 and "1" or "2"); return
    end
    char.HumanoidRootPart.CFrame = pos
    btn.Text = "Teleported! ✓"; wait(1)
    selectionFrame.Size = UDim2.new(0.8,0,0,0); selectionVisible = false
    btn.Text = "Teleport to Saved "..(btn==choice1 and "1" or "2")
